# Token del bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ID del canal de dailies (click derecho sobre el canal > Copiar ID,
# con Modo desarrollador activado en Ajustes de Discord)
CANAL_ID=

# ID de la planilla: docs.google.com/spreadsheets/d/<ESTO_ES_EL_ID>/edit
SHEET_ID=

# Nombre de la pestaña dentro de la planilla
HOJA=Dailies

# Archivo JSON de la service account de Google
GOOGLE_CREDENTIALS_FILE=credentials.json

TZ=America/Argentina/Cordoba

# Guarda el ID del mensaje en la columna G (ocultala en Sheets).
# Permite deduplicar y actualizar la fila si editan el mensaje.
GUARDAR_MSG_ID=true
